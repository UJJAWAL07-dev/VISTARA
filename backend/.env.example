# Copy this file to .env and adjust values for your local setup.
# Never commit the actual .env file.

APP_NAME=VISTARA backend
ENVIRONMENT=development

# Comma-separated list of allowed origins for CORS (e.g. the frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reserved for Phase 5 (database integration) - not used yet
DATABASE_URL=

# Phase 4: integration adapter modes. Only "mock" is implemented -
# do not set these to "real" until the corresponding adapter has an
# actual real-mode implementation, or requests will fail with a
# clear (non-crashing) error.
AI_MODE=mock
GIS_MODE=mock
ANALYSIS_MODE=mock
